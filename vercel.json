{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "includeFiles": "{index.html,404.html,humans.txt,llms.txt,robots.txt,sitemap.xml,assets/**,.well-known/**,app/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/internal/erasure-sweep", "schedule": "0 3 * * *" }
  ]
}
