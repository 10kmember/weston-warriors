    "seed": "node db/seed.js",
    "reset": "npm run migrate && npm run seed",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
