# Copy to .env and fill in. Nothing here is read automatically: pass it through
# your process manager, or `export $(grep -v '^#' .env | xargs)` in a shell.

# PostgreSQL connection string.
DATABASE_URL=postgres://warriors:warriors_dev@127.0.0.1:5432/weston_warriors

# Peppers the session token hash. Rotating it signs everybody out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# production turns on secure cookies and HSTS, and refuses to start without a
# real SESSION_SECRET.
NODE_ENV=development
PORT=3000

# Version stamped onto consent records. Bump it when the privacy policy changes
# so you can tell which version each member agreed to.
POLICY_VERSION=1.0
